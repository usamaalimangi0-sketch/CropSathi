# CropSathi AI - Environment Configuration

# Google Gemini API Key for vision crop diagnosis and farming assistant
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Vision capable, e.g. gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Database Configuration (SQLite for hackathon & local development)
DATABASE_URL=sqlite:///./cropsathi.db

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Upload restrictions
MAX_UPLOAD_SIZE_MB=8

# Optional: Host & Port
HOST=0.0.0.0
PORT=8000
